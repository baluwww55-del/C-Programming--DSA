// so this is the simple of example of array indexing and array how to acces array using indexing 
// eg : for the 2d) arrays :
#include <stdio.h>
int main()
{
    int grid[2][3] = {{1, 2, 3}, {4, 5, 6}};

    for (int r = 0; r < 2; r++) {
        for (int c = 0; c < 3; c++) {
            printf("%d ", grid[r][c]);
        }
        printf("\n");
    }
    return 0;
}
// this is the simple code for 2d arrays  .
